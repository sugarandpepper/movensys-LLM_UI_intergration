# A single point the user marked on the map (see MapViewer's click log: A, B, C, ...).
# yaw is set by dragging when the point is placed (arrow direction); defaults to 0
# for a plain click with no drag.
string label   # e.g. "A", "B", "C"
float64 x      # world x (meters)
float64 y      # world y (meters)
float64 yaw    # heading (radians)
